# Copy to backend/.env. Every setting is read with the SPONSR_ prefix (see app/config.py).

# SQLite by default (backend/data/sponsr.db). Any SQLAlchemy URL works.
# SPONSR_DATABASE_URL=sqlite:///./data/sponsr.db

# JWT signing secret for session cookies. Generate one: python -c "import secrets; print(secrets.token_urlsafe(48))"
SPONSR_JWT_SECRET=change-me
SPONSR_SESSION_DAYS=14
# true when served over HTTPS
SPONSR_COOKIE_SECURE=false

# Amazon Bedrock (credentials come from the standard AWS chain: env vars, profile or instance role)
SPONSR_AWS_REGION=us-east-1
SPONSR_CV_MODEL=us.anthropic.claude-sonnet-5-5

# Daily import from the upstream matching engine (POST /api/admin/import, header X-Import-Key). Empty = disabled.
SPONSR_IMPORT_KEY=
# Account that receives the import, and that the MCP server acts as
SPONSR_IMPORT_USER=demo

# Public base URL (OAuth issuer and links for the MCP server)
SPONSR_APP_URL=http://localhost:5190
# Static bearer token for /mcp (Claude Code). Empty = only OAuth sign-in.
SPONSR_MCP_TOKEN=
